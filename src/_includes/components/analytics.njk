{% if site.analytics %}
<!-- Analytics -->
{% if site.analytics.google %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.google }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.analytics.google }}');
</script>
{% endif %}

{% if site.analytics.plausible %}
<script defer data-domain="{{ site.analytics.plausibleDomain }}" src="https://plausible.io/js/script.js"></script>
{% endif %}

{% if site.analytics.vercel and site.analytics.vercel !== false %}
<script>
  window.va = window.va || function () { (window.va.q = window.va.q || []).push(arguments); };
</script>
<script defer src="/_vercel/insights/script.js"></script>
{% endif %}
{% endif %}
