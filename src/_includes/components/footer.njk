<footer class="relative bg-black border-t border-white/10 pt-16 pb-8 overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-center mb-12">
            <div class="mb-6 md:mb-0">
                <h3 class="text-xl font-bold text-white mb-2">{{ site.name }}</h3>
                <p class="text-gray-500 text-sm max-w-xs">
                    Independent partner resource. Not an official representation of SetHubble Inc.
                </p>
            </div>
            <div class="flex gap-6">
                {% if site.social.telegram %}
                <a href="{{ site.social.telegram }}" target="_blank" class="text-gray-400 hover:text-indigo-400 transition">Telegram</a>
                {% endif %}
            </div>
        </div>
        <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-gray-600">
            <p>&copy; 2026 {{ site.name }}. All rights reserved.</p>
            <div class="flex gap-4 mt-4 md:mt-0">
                <a href="#" class="hover:text-gray-400">Privacy</a>
                <a href="#" class="hover:text-gray-400">Terms</a>
            </div>
        </div>
    </div>
</footer>
