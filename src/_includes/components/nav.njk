        class="text-sm font-medium text-gray-300 hover:text-white transition"
      >FAQ</a>
    </div>

    <!-- CTA Button -->
    <div class="hidden lg:flex items-center gap-4">
      <a
        href="{{ site.affiliate_link }}"
