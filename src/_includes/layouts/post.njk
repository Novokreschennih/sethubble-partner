---
layout: layouts/base.njk
---

<article class="max-w-4xl mx-auto px-6 py-20">
    <!-- Кнопка Назад -->
    <a href="/blog/" class="inline-flex items-center text-sm text-gray-400 hover:text-white mb-8 transition group">
        <span class="mr-2 group-hover:-translate-x-1 transition-transform">←</span> Back to Blog
    </a>

    <!-- Шапка статьи -->
    <header class="mb-10 text-center">
        <!-- ТЕГИ (Красивые кнопки вместо сплошного текста) -->
        <div class="flex flex-wrap gap-2 justify-center mb-6">
            {% for tag in tags %}
                <!-- Исключаем служебный тег 'post' -->
                {% if tag != "post" %}
                <a href="/tags/{{ tag }}/" class="text-xs font-bold tracking-widest uppercase px-3 py-1 rounded-full border border-indigo-500/30 text-indigo-400 hover:bg-indigo-500/10 transition">
                    {{ siteTags[tag] or tag }}
                </a>
                {% endif %}
            {% endfor %}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight text-white">{{ title }}</h1>
        
        <div class="flex items-center justify-center gap-4 text-sm text-gray-500 font-mono">
            <time datetime="{{ date | dateIso }}">{{ date | postDate }}</time>
            <span>•</span>
            <span>5 min read</span>
        </div>
    </header>

    <!-- КАРТИНКА (Исправлено) -->
    {% if image %}
    <div class="mb-12 rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative group">
        <!-- Используем стандартный тег img для надежности -->
        <img src="{{ image }}" alt="{{ title }}" class="w-full h-auto object-cover transform group-hover:scale-105 transition duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
    </div>
    {% endif %}

    <!-- Контент статьи -->
    <!-- prose-lg увеличивает шрифт, prose-invert делает его белым -->
    <div class="prose prose-lg prose-invert max-w-none 
                prose-headings:font-bold prose-headings:text-white 
                prose-p:text-gray-300 prose-p:leading-relaxed
                prose-a:text-indigo-400 hover:prose-a:text-indigo-300 
                prose-li:text-gray-300
                prose-strong:text-white">
        {{ content | safe }}
    </div>

    <!-- Навигация (Следующая/Предыдущая) -->
    {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
    {% set nextPost = collections.posts | getNextCollectionItem(page) %}

    {% if previousPost or nextPost %}
    <div class="border-t border-white/10 mt-16 pt-12">
        <div class="grid md:grid-cols-2 gap-6">
            {% if previousPost %}
            <a href="{{ previousPost.url }}" class="group flex flex-col p-6 rounded-2xl border border-white/10 hover:border-indigo-500/50 hover:bg-white/5 transition duration-300 text-left">
                <span class="text-xs text-gray-500 mb-2 uppercase tracking-wider">← Previous</span>
                <span class="text-lg font-bold text-white group-hover:text-indigo-300 transition">{{ previousPost.data.title }}</span>
            </a>
            {% else %}
            <div></div>
            {% endif %}

            {% if nextPost %}
            <a href="{{ nextPost.url }}" class="group flex flex-col p-6 rounded-2xl border border-white/10 hover:border-indigo-500/50 hover:bg-white/5 transition duration-300 text-right">
                <span class="text-xs text-gray-500 mb-2 uppercase tracking-wider">Next →</span>
                <span class="text-lg font-bold text-white group-hover:text-indigo-300 transition">{{ nextPost.data.title }}</span>
            </a>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <!-- Призыв к действию внизу -->
    <div class="mt-20 p-10 border border-indigo-500/30 rounded-3xl bg-indigo-900/10 text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/20 rounded-full blur-[80px] pointer-events-none"></div>
        <h3 class="text-3xl font-bold mb-4 text-white relative z-10">Ready to automate your income?</h3>
        <p class="text-gray-300 mb-8 max-w-xl mx-auto relative z-10">Use the calculator to see how much you can earn with the SetHubble ecosystem.</p>
        <a href="/calculator/" class="relative z-10 inline-block px-8 py-4 bg-white text-black hover:bg-gray-200 rounded-full font-bold transition shadow-[0_0_20px_rgba(255,255,255,0.3)]">
            Open Calculator
        </a>
    </div>
</article>