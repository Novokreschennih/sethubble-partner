---
layout: layouts/base.njk
---

<article class="max-w-4xl mx-auto px-6 py-20">
    <!-- Кнопка Назад -->
    <a href="/blog/" class="inline-flex items-center text-sm text-gray-400 hover:text-white mb-8 transition group">
        <span class="mr-2 group-hover:-translate-x-1 transition-transform">←</span> Back to Blog
    </a>

    <!-- Шапка статьи -->
    <header class="mb-12 text-center">
        <div class="text-indigo-400 text-sm font-bold tracking-widest uppercase mb-4">{{ tags }}</div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">{{ title }}</h1>
        <time class="text-gray-500 font-mono text-sm" datetime="{{ date | dateIso }}">{{ date | postDate }}</time>
    </header>

    <!-- Картинка (если есть) -->
    {% if image %}
    <div class="mb-12 rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <img src="{{ image }}" alt="{{ title }}" class="w-full h-auto object-cover">
    </div>
    {% endif %}

    <!-- Контент статьи (Typography) -->
    <div class="prose prose-invert prose-lg max-w-none prose-headings:font-bold prose-a:text-indigo-400 hover:prose-a:text-indigo-300 prose-img:rounded-xl text-gray-300">
        {{ content | safe }}
    </div>
    <!-- Навигация по статьям (Previous / Next) -->
    {% set previousPost = collections.post | getPreviousCollectionItem(page) %}
    {% set nextPost = collections.post | getNextCollectionItem(page) %}

    {% if previousPost or nextPost %}
    <div class="border-t border-white/10 mt-16 pt-12">
        <div class="grid md:grid-cols-2 gap-6">
            
            <!-- Кнопка "Предыдущая статья" -->
            {% if previousPost %}
            <a href="{{ previousPost.url }}" class="group flex flex-col p-6 rounded-2xl border border-white/10 hover:border-indigo-500/50 hover:bg-white/5 transition duration-300 text-left">
                <span class="text-xs text-gray-500 mb-2 group-hover:text-indigo-400 uppercase tracking-wider transition-colors">← Previous Article</span>
                <span class="text-lg font-bold text-white leading-tight group-hover:text-indigo-200 transition-colors">{{ previousPost.data.title }}</span>
            </a>
            {% else %}
            <!-- Пустой блок, чтобы правая кнопка осталась справа -->
            <div class="hidden md:block"></div>
            {% endif %}

            <!-- Кнопка "Следующая статья" -->
            {% if nextPost %}
            <a href="{{ nextPost.url }}" class="group flex flex-col p-6 rounded-2xl border border-white/10 hover:border-indigo-500/50 hover:bg-white/5 transition duration-300 text-right">
                <span class="text-xs text-gray-500 mb-2 group-hover:text-indigo-400 uppercase tracking-wider transition-colors">Next Article →</span>
                <span class="text-lg font-bold text-white leading-tight group-hover:text-indigo-200 transition-colors">{{ nextPost.data.title }}</span>
            </a>
            {% endif %}

        </div>
    </div>
    {% endif %}
    <!-- Призыв к действию внизу -->
    <div class="mt-20 p-8 border border-white/10 rounded-2xl bg-white/5 text-center">
        <h3 class="text-2xl font-bold mb-4">Ready to start earning?</h3>
        <p class="text-gray-400 mb-6">Join the ecosystem today and monetize your network.</p>
        <a href="{{ site.affiliate_link }}" target="_blank" class="inline-block px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full font-bold transition">
            Get Started
        </a>
    </div>
</article>
