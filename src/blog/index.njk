---
layout: layouts/base.njk
title: Blog & Updates
eleventyExcludeFromCollections: true
tags: [] 
pagination:
  data: collections.post
  size: 6
  alias: posts
  reverse: true
---

<div class="container mx-auto px-6 py-20">
    <!-- Заголовок -->
    <div class="text-center mb-16">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Latest <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-indigo-500">Insights</span></h1>
        <p class="text-gray-400 max-w-2xl mx-auto text-lg">
            News, strategies, and guides on how to maximize your income with SetHubble.
        </p>
    </div>

    <!-- Сетка статей -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {% for post in posts %}
        <article class="glass-card rounded-2xl overflow-hidden hover:border-indigo-500/50 transition duration-300 flex flex-col group">
            <a href="{{ post.url }}" class="block flex-grow">
                <div class="p-8 flex flex-col h-full">
                    <div class="text-xs text-indigo-400 font-bold tracking-widest uppercase mb-3">Article</div>
                    <h2 class="text-2xl font-bold mb-4 group-hover:text-indigo-300 transition">{{ post.data.title }}</h2>
                    <p class="text-gray-400 text-sm mb-6 flex-grow line-clamp-3">
                        {{ post.data.description }}
                    </p>
                    <div class="flex justify-between items-center text-xs text-gray-500 font-mono mt-auto border-t border-white/5 pt-4">
                        <span>{{ post.date | postDate }}</span>
                        <span class="text-white group-hover:translate-x-1 transition-transform">Read more →</span>
                    </div>
                </div>
            </a>
        </article>
        {% endfor %}
    </div>

    <!-- Навигация по страницам (Pagination) -->
    {% if pagination.href.previous or pagination.href.next %}
    <div class="flex justify-center gap-4">
        {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="px-6 py-2 border border-white/10 rounded-full hover:bg-white/10 transition">← Previous</a>
        {% endif %}
        
        {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="px-6 py-2 border border-white/10 rounded-full hover:bg-white/10 transition">Next →</a>
        {% endif %}
    </div>
    {% endif %}
</div>
