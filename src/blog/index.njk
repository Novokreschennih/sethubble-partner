---
layout: layouts/base.njk
title: SetHubble Blog
eleventyExcludeFromCollections: true
pagination:
  data: collections.posts
  size: 6
  alias: posts
  reverse: true
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<div class="container mx-auto px-6 py-20">
    <!-- Заголовок -->
    <div class="text-center mb-12">
        <span class="text-indigo-400 font-bold tracking-widest uppercase text-sm">Knowledge Base</span>
        <h1 class="text-4xl md:text-6xl font-bold mt-2 mb-6">Latest <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-indigo-500">Insights</span></h1>
        <p class="text-gray-400 max-w-2xl mx-auto text-lg mb-8">
            News, strategies, and guides on how to maximize your income with SetHubble.
        </p>
        
        <!-- Облако тегов -->
        {% include "components/tagcloud.njk" %}
    </div>

    <!-- Сетка статей -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {% for post in posts %}
        <article class="glass-card rounded-2xl overflow-hidden hover:border-indigo-500/50 transition duration-300 flex flex-col group h-full">
            <a href="{{ post.url }}" class="flex flex-col h-full">
                <!-- Картинка -->
                {% if post.data.image %}
                <div class="h-48 overflow-hidden relative">
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="w-full h-full object-cover transform group-hover:scale-105 transition duration-500">
                    <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition"></div>
                </div>
                {% endif %}

                <!-- Контент карточки -->
                <div class="p-6 flex flex-col flex-grow">
                    <!-- Теги внутри карточки (берем первый) -->
                    <div class="mb-3">
                        {% for tag in post.data.tags %}
                            {% if tag != 'posts' %} <!-- Исключаем технический тег -->
                            <span class="text-[10px] uppercase font-bold text-indigo-400 border border-indigo-500/30 px-2 py-1 rounded-full">
                                {{ siteTags[tag] or tag }}
                            </span>
                            {% endif %}
                        {% endfor %}
                    </div>

                    <h2 class="text-xl font-bold mb-3 text-white group-hover:text-indigo-300 transition leading-tight">
                        {{ post.data.title }}
                    </h2>
                    
                    <p class="text-gray-400 text-sm mb-4 line-clamp-3 flex-grow">
                        {{ post.data.description }}
                    </p>
                    
                    <div class="flex justify-between items-center text-xs text-gray-500 font-mono mt-auto pt-4 border-t border-white/5">
                        <span>{{ post.date | postDate }}</span>
                        <span class="text-white group-hover:translate-x-1 transition-transform">Read more →</span>
                    </div>
                </div>
            </a>
        </article>
        {% endfor %}
    </div>

    <!-- Навигация по страницам (Pagination) -->
    {% if pagination.href.previous or pagination.href.next %}
    <div class="flex justify-center gap-4">
        {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="px-6 py-2 border border-white/10 rounded-full hover:bg-white/10 transition text-white">← Previous</a>
        {% endif %}
        
        {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="px-6 py-2 border border-white/10 rounded-full hover:bg-white/10 transition text-white">Next →</a>
        {% endif %}
    </div>
    {% endif %}
</div>